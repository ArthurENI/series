{% extends 'base.html.twig' %}


{% block extraStyles %}
    <style>
        body {
            background-image: linear-gradient(rgb(0, 0, 0, 0.9), rgba(0, 0, 0, 0.2)),
            url("{{ asset('img/backdrops/' ~ serie.backdrop) }}");
        }
    </style>
{% endblock %}

{% block extraJS %}
    <script>
        let buttons = Array.from(document.querySelectorAll('.btn-like'));
        buttons.forEach(function (button) {
            button.addEventListener('click', async function () {
                const response = await fetch('{{ path('api_serie_update_like',{'id': serie.id}) }}'
                    , {method: 'PATCH', body: JSON.stringify({'likes': button.value})})
                if (response.ok) {
                    let data = await response.json()
                    document.getElementById('nbLike').innerText = data.nbLike
                }

            });
        });


    </script>
{% endblock %}

{% block body %}
    <section>
        <div class="serie-details">
            <div>
                <img src="{{ asset('img/posters/series/' ~ serie.poster) }}" alt="{{ serie.name }}">
            </div>
            <div class="serie-details-infos">
                <h2>Detail of {{ serie.name }}</h2>
                <div>
                    <a class="link_button" href="{{ path('serie_delete', {'id': serie.id}) }}"
                       onclick="return confirm('Are you sure you want to delete {{ serie.name }} ?')">Delete</a>
                    <a class="link_button" href="{{ path('serie_update', {'id': serie.id}) }}">Update</a>
                    <a class="link_button" href="{{ path('season_create_with_serie', {'id': serie.id}) }}">Add
                        season</a></div>
                <div>
                    Likes : <span id="nbLike">{{ serie.nbLike }}</span>
                    <button class="btn-like" value="1">&#128077</button>
                    <button class="btn-like" value="-1">&#128078</button>
                </div>
                <div>User ratings : {{ serie.vote }}</div>
                <div>Categorized in : {{ serie.genres }}</div>
                <div>Serie status : {{ serie.status }}</div>
                <div>Aired from : {{ serie.firstAirDate | date('Y-m-d') }}
                    to {{ serie.lastAirDate | date('Y-m-d') }} </div>
                <div>{{ serie.overview | nl2br }}</div>
            </div>
        </div>

        <div class="seasons">
            <h3>Season !</h3>
            {% for season in serie.seasons %}
                <article>
                    <img src="{{ asset('img/posters/seasons/'~ season.poster) }}"
                         alt="{{ serie.name }} #{{ season.number }}">
                    <div>
                        <h4>#{{ season.number }}</h4>
                        <div>{{ season.firstAirDate | date('d/m/Y') }}</div>
                        <div>{{ season.overview | nl2br }}</div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

{% endblock %}

